<Window x:Class="FutbinSearch.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FutbinSearch.Converters"
        xmlns:vm="clr-namespace:FutbinSearch.ViewModels"
        xmlns:ctrl="clr-namespace:FutbinSearch.Views.Controls"
        Title="FUTBIN Card Search — FC 25"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="#1A1A2E"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToVisibilityConverter  x:Key="BoolToVisible"/>
        <conv:HexColorToBrushConverter   x:Key="HexToBrush"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisible"/>
        <conv:IntToStarsConverter        x:Key="ToStars"/>

        <!-- Estilo padrão de TextBlock branco -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Estilo de Label do painel de filtros -->
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>

        <!-- Estilo de ComboBox com tema escuro -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252540"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3D3D6B"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Estilo de TextBox com tema escuro -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252540"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3D3D6B"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <!-- Estilo primário de botão (azul) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3D6BCC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5080E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#2A2A4A"/>
                                <Setter Property="Foreground" Value="#666688"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo secundário de botão (cinza escuro) -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2A2A4A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A5A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo de Slider para filtro de rating -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#3D6BCC"/>
        </Style>
    </Window.Resources>

    <!-- Layout principal: cabeçalho + conteúdo -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Cabeçalho -->
            <RowDefinition Height="*"/>   <!-- Conteúdo principal -->
            <RowDefinition Height="Auto"/> <!-- Barra de status -->
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════════════════
             CABEÇALHO
             ════════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#0F0F1E" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo / Título -->
                    <TextBlock Text="⚽" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FUTBIN Card Search"
                                   FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="EA FC 25 — Busca de Cartas Ultimate Team"
                                   FontSize="11" Foreground="#8888AA"/>
                    </StackPanel>
                </StackPanel>

                <!-- Badge da versão -->
                <Border HorizontalAlignment="Right" Background="#3D6BCC" CornerRadius="12" Padding="12,4">
                    <TextBlock Text="FC 25" FontSize="12" FontWeight="Bold" Foreground="White"/>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════════════
             CONTEÚDO PRINCIPAL (Filtros + Resultados)
             ════════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>  <!-- Painel de Filtros -->
                <ColumnDefinition Width="*"/>    <!-- Área de Resultados -->
            </Grid.ColumnDefinitions>

            <!-- ── Painel de Filtros (esquerdo) ─────────────────────────────────── -->
            <Border Grid.Column="0" Background="#12122A" BorderBrush="#2A2A4A"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <TextBlock Text="FILTROS" FontSize="13" FontWeight="Bold"
                                   Foreground="#7B8CDE" Margin="0,0,0,12"/>

                        <!-- Campo de busca por nome -->
                        <TextBlock Text="Nome do Jogador" Style="{StaticResource FilterLabel}"/>
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13"
                                     KeyDown="SearchBox_KeyDown"/>
                            <TextBlock Text="Ex: Mbappé, Haaland..."
                                       Foreground="#555577" FontSize="11"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchTerm}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Tipo de Carta -->
                        <TextBlock Text="Tipo de Carta" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="VersionCombo" SelectionChanged="VersionCombo_SelectionChanged"/>

                        <!-- Posição -->
                        <TextBlock Text="Posição" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="PositionCombo" SelectionChanged="PositionCombo_SelectionChanged"/>

                        <!-- Rating -->
                        <TextBlock Style="{StaticResource FilterLabel}">
                            <Run Text="Rating: "/>
                            <Run Text="{Binding MinRating, Mode=OneWay}" Foreground="White" FontWeight="Bold"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding MaxRating, Mode=OneWay}" Foreground="White" FontWeight="Bold"/>
                        </TextBlock>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="40" Maximum="99"
                                    Value="{Binding MinRating}" SmallChange="1"
                                    Margin="0,0,4,0" ToolTip="Rating mínimo"/>
                            <Slider Grid.Column="1" Minimum="40" Maximum="99"
                                    Value="{Binding MaxRating}" SmallChange="1"
                                    Margin="4,0,0,0" ToolTip="Rating máximo"/>
                        </Grid>

                        <!-- Playstyle -->
                        <TextBlock Text="Playstyle" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="PlaystyleCombo" SelectionChanged="PlaystyleCombo_SelectionChanged"/>

                        <!-- Liga (com campo de texto para busca manual de ID) -->
                        <TextBlock Text="Liga" Style="{StaticResource FilterLabel}"/>
                        <Border Background="#252540" CornerRadius="4" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="{Binding LeagueDisplay}" FontSize="11" Foreground="White"/>
                                <TextBlock Text="(ID numérico do FUTBIN)" FontSize="9"
                                           Foreground="#666688" Margin="0,2,0,0"/>
                                <TextBox x:Name="LeagueIdBox" Margin="0,4,0,0"
                                         Background="#1A1A35" FontSize="11"
                                         TextChanged="LeagueIdBox_TextChanged"
                                         ToolTip="Digite o ID da liga (ex: 53 para Premier League)"/>
                            </StackPanel>
                        </Border>

                        <!-- Time -->
                        <TextBlock Text="Time" Style="{StaticResource FilterLabel}"/>
                        <Border Background="#252540" CornerRadius="4" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="{Binding TeamDisplay}" FontSize="11" Foreground="White"/>
                                <TextBox x:Name="TeamIdBox" Margin="0,4,0,0"
                                         Background="#1A1A35" FontSize="11"
                                         TextChanged="TeamIdBox_TextChanged"
                                         ToolTip="Digite o ID do time (ex: 73 para PSG)"/>
                            </StackPanel>
                        </Border>

                        <!-- País -->
                        <TextBlock Text="País / Nação" Style="{StaticResource FilterLabel}"/>
                        <Border Background="#252540" CornerRadius="4" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="{Binding NationDisplay}" FontSize="11" Foreground="White"/>
                                <TextBox x:Name="NationIdBox" Margin="0,4,0,0"
                                         Background="#1A1A35" FontSize="11"
                                         TextChanged="NationIdBox_TextChanged"
                                         ToolTip="Digite o ID da nação (ex: 76 para França)"/>
                            </StackPanel>
                        </Border>

                        <!-- Botões de ação -->
                        <Button Content="🔍  Buscar Cartas"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,16,0,6" Height="38"/>

                        <Button Content="✕  Limpar Filtros"
                                Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Height="32"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── Área de Resultados (direito) ──────────────────────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Cabeçalho de resultados -->
                    <RowDefinition Height="*"/>   <!-- Grade de cartas -->
                    <RowDefinition Height="Auto"/> <!-- Botão "Carregar Mais" -->
                </Grid.RowDefinitions>

                <!-- Sub-cabeçalho dos resultados -->
                <Border Grid.Row="0" Background="#16163A" Padding="16,10">
                    <Grid>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="Resultados" FontWeight="Bold" FontSize="14" Foreground="White"/>
                            <Run Text=" — " Foreground="#555577"/>
                            <Run Text="{Binding PlayerCards.Count, Mode=OneWay}"
                                 FontWeight="Bold" Foreground="#7B8CDE"/>
                            <Run Text=" carta(s)" Foreground="#555577"/>
                        </TextBlock>

                        <!-- Spinner de carregamento -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="Carregando..." Foreground="#7B8CDE"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <!-- Indicador de progresso circular -->
                            <Border Width="20" Height="20">
                                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                <Border.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SpinnerRotate"
                                                    Storyboard.TargetProperty="Angle"
                                                    From="0" To="360" Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Ellipse Stroke="#3D6BCC" StrokeThickness="3" Width="18" Height="18"
                                         StrokeDashArray="10 5"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Banner de erro (visível apenas quando há erro) -->
                <Border Grid.Row="0" Background="#5C0000" Padding="16,10" Margin="0,42,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisible}}">
                    <Grid>
                        <TextBlock>
                            <Run Text="⚠ " FontSize="14"/>
                            <Run Text="{Binding ErrorMessage}" FontSize="12" Foreground="#FFAAAA"/>
                        </TextBlock>
                        <Button Content="✕" HorizontalAlignment="Right"
                                Background="Transparent" Foreground="#FFAAAA"
                                BorderThickness="0" FontSize="14" Cursor="Hand"
                                Click="DismissError_Click"/>
                    </Grid>
                </Border>

                <!-- Grade de cartas com scroll -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">

                    <!-- Estado vazio: nenhum resultado -->
                    <Grid>
                        <!-- Mensagem de estado inicial / sem resultados -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,60">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasResults}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="⚽" FontSize="64" HorizontalAlignment="Center"
                                       Opacity="0.2"/>
                            <TextBlock Text="Nenhuma carta encontrada"
                                       FontSize="18" Foreground="#555577"
                                       HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Text="Use os filtros à esquerda ou digite um nome e clique em Buscar."
                                       FontSize="12" Foreground="#444466"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Grade de cartas (WrapPanel para layout responsivo) -->
                        <ItemsControl ItemsSource="{Binding PlayerCards}"
                                      Visibility="{Binding HasResults, Converter={StaticResource BoolToVisible}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- WrapPanel distribui as cartas em linhas automaticamente -->
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Cada item é um controle de carta clicável -->
                                    <ctrl:PlayerCardControl
                                        Card="{Binding}"
                                        CardClickCommand="{Binding DataContext.OpenDetailCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="8"
                                        ToolTip="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <!-- Botão "Carregar Mais" -->
                <Border Grid.Row="2" Background="#12122A" Padding="0,8"
                        Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVisible}}">
                    <Button Content="⬇  Carregar Mais Cartas"
                            Command="{Binding LoadMoreCommand}"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Center"
                            Width="220" Height="36"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════════════════
             BARRA DE STATUS (rodapé)
             ════════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0A0A18" Padding="16,6">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11" Foreground="#666688"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Dados fornecidos pelo FUTBIN · EA FC 25"
                           FontSize="10" Foreground="#333355"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
