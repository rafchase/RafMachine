<Window x:Class="FutbinSearch.Views.PlayerDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FutbinSearch.Converters"
        xmlns:vm="clr-namespace:FutbinSearch.ViewModels"
        Title="Detalhes da Carta"
        Width="900" Height="680"
        MinWidth="750" MinHeight="550"
        Background="#1A1A2E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <conv:BoolToVisibilityConverter   x:Key="BoolToVisible"/>
        <conv:HexColorToBrushConverter    x:Key="HexToBrush"/>
        <conv:NullToVisibilityConverter   x:Key="NullToVisible"/>
        <conv:IntToStarsConverter         x:Key="ToStars"/>
        <conv:RatingToColorConverter      x:Key="RatingColor"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisible"/>
        <conv:PriceFormatter              x:Key="PriceFormat"/>
        <conv:CountToVisibilityConverter  x:Key="CountToVisible"/>

        <!-- Label de seção -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7B8CDE"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Label de atributo -->
        <Style x:Key="AttrLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Valor de atributo -->
        <Style x:Key="AttrValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Estilo de botão de plataforma -->
        <Style x:Key="PlatformButton" TargetType="Button">
            <Setter Property="Background" Value="#252540"/>
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D3D6B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template para uma barra de stat principal (label + valor + barra) -->
        <DataTemplate x:Key="MainStatTemplate" DataType="{x:Type vm:StatItem}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}"
                           FontSize="12" FontWeight="Bold" Foreground="#AAAACC"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}"
                           FontSize="14" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>
                <Border Grid.Column="2" Height="10" CornerRadius="5"
                        Background="#222244" VerticalAlignment="Center">
                    <Border CornerRadius="5" HorizontalAlignment="Left" Width="{Binding BarWidth}">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding BarColor}"/>
                        </Border.Background>
                    </Border>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Layout principal -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>   <!-- Corpo -->
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════════════════
             HEADER: Imagem da carta + dados básicos
             ════════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Padding="20,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#CC0A0A20" Offset="0"/>
                    <GradientStop Color="#AA1A1A40" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Imagem -->
                    <ColumnDefinition Width="*"/>   <!-- Dados -->
                    <ColumnDefinition Width="Auto"/> <!-- Preços -->
                </Grid.ColumnDefinitions>

                <!-- Imagem da carta -->
                <Border Grid.Column="0" Width="130" Height="185" Margin="0,0,20,0"
                        Background="#22FFFFFF" CornerRadius="8">
                    <!-- Placeholder -->
                    <Grid>
                        <TextBlock Text="⚽" FontSize="48" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Opacity="0.3"
                                   Foreground="White"
                                   Visibility="{Binding CardImage, Converter={StaticResource NullToVisible}}"/>
                        <Image Source="{Binding CardImage}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding CardImage,
                                   Converter={StaticResource NullToVisible}, ConverterParameter=Invert}"/>
                    </Grid>
                </Border>

                <!-- Dados do jogador -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Card.DisplayName}"
                               FontSize="28" FontWeight="Bold" Foreground="White"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Card.Name}" FontSize="13" Foreground="#AAAACC"
                               Margin="0,2,0,8"
                               Visibility="{Binding Card.CommonName, Converter={StaticResource StringToVisible}}"/>

                    <!-- Rating, Posição e Tipo -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#33FFFFFF" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Card.Rating}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{Binding Card.Rating, Converter={StaticResource RatingColor}}"/>
                        </Border>
                        <Border Background="#22FFFFFF" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Card.Position}" FontSize="16" Foreground="White"/>
                        </Border>
                        <Border Background="#22FFFFFF" CornerRadius="6" Padding="8,4">
                            <TextBlock Text="{Binding Card.CardType}" FontSize="12" Foreground="#FFD700"/>
                        </Border>
                    </StackPanel>

                    <!-- Clube / Liga / Nação -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Image Source="{Binding ClubImage}" Width="24" Height="24" Margin="0,0,6,0"
                               Visibility="{Binding ClubImage,
                                   Converter={StaticResource NullToVisible}, ConverterParameter=Invert}"/>
                        <TextBlock Text="{Binding Card.Club}" FontSize="13"
                                   Foreground="#DDDDFF" Margin="0,0,12,0"/>
                        <TextBlock Text="·" Foreground="#555577" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Card.League}" FontSize="13"
                                   Foreground="#DDDDFF" Margin="0,0,12,0"/>
                        <TextBlock Text="·" Foreground="#555577" Margin="0,0,12,0"/>
                        <Image Source="{Binding NationImage}" Width="28" Height="18" Margin="0,0,6,0"
                               Visibility="{Binding NationImage,
                                   Converter={StaticResource NullToVisible}, ConverterParameter=Invert}"/>
                        <TextBlock Text="{Binding Card.Nation}" FontSize="13" Foreground="#DDDDFF"/>
                    </StackPanel>

                    <!-- Badges de informações físicas/técnicas -->
                    <WrapPanel>
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Idade: " Style="{StaticResource AttrLabel}"/>
                                <TextBlock Text="{Binding Card.Age}" Style="{StaticResource AttrValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Alt: " Style="{StaticResource AttrLabel}"/>
                                <TextBlock Text="{Binding Card.Height}" Style="{StaticResource AttrValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Peso: " Style="{StaticResource AttrLabel}"/>
                                <TextBlock Text="{Binding Card.Weight}" Style="{StaticResource AttrValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Pé: " Style="{StaticResource AttrLabel}"/>
                                <TextBlock Text="{Binding Card.PreferredFoot}" Style="{StaticResource AttrValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SM: " Style="{StaticResource AttrLabel}"/>
                                <TextBlock Text="{Binding Card.SkillMoves, Converter={StaticResource ToStars}}"
                                           Foreground="#FFD700" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="8,3" Margin="0,0,6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PF: " Style="{StaticResource AttrLabel}"/>
                                <TextBlock Text="{Binding Card.WeakFoot, Converter={StaticResource ToStars}}"
                                           Foreground="#FFD700" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="8,3" Margin="0,0,6,4"
                                Visibility="{Binding Card.WorkRate, Converter={StaticResource StringToVisible}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="WR: " Style="{StaticResource AttrLabel}"/>
                                <TextBlock Text="{Binding Card.WorkRate}" Style="{StaticResource AttrValue}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Painel de preços -->
                <Border Grid.Column="2" Background="#22000000" CornerRadius="8" Padding="16,12"
                        VerticalAlignment="Center" MinWidth="160">
                    <StackPanel>
                        <TextBlock Text="PREÇO DE MERCADO" Style="{StaticResource SectionLabel}"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <!-- Seletor de plataforma -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Button Content="PS" Style="{StaticResource PlatformButton}"
                                    Command="{Binding ChangePlatformCommand}" CommandParameter="PS"
                                    Margin="2"/>
                            <Button Content="Xbox" Style="{StaticResource PlatformButton}"
                                    Command="{Binding ChangePlatformCommand}" CommandParameter="Xbox"
                                    Margin="2"/>
                            <Button Content="PC" Style="{StaticResource PlatformButton}"
                                    Command="{Binding ChangePlatformCommand}" CommandParameter="PC"
                                    Margin="2"/>
                        </StackPanel>

                        <!-- Preço em destaque -->
                        <TextBlock Text="{Binding DisplayedPrice}"
                                   FontSize="28" FontWeight="Bold" Foreground="#FFD700"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedPlatform}"
                                   FontSize="11" Foreground="#888899"
                                   HorizontalAlignment="Center"/>

                        <Separator Background="#333355" Margin="0,8"/>

                        <!-- Todas as plataformas -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="PlayStation"
                                       Style="{StaticResource AttrLabel}" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Card.PricePS, Converter={StaticResource PriceFormat}}"
                                       Style="{StaticResource AttrValue}" Foreground="#FFD700"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Xbox"
                                       Style="{StaticResource AttrLabel}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Card.PriceXbox, Converter={StaticResource PriceFormat}}"
                                       Style="{StaticResource AttrValue}" Foreground="#FFD700"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="PC"
                                       Style="{StaticResource AttrLabel}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding Card.PricePC, Converter={StaticResource PriceFormat}}"
                                       Style="{StaticResource AttrValue}" Foreground="#FFD700"/>
                        </Grid>

                        <!-- Botão abrir no FUTBIN -->
                        <Button Content="🌐 Ver no FUTBIN"
                                Command="{Binding OpenInBrowserCommand}"
                                Style="{StaticResource PlatformButton}"
                                Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════════════
             CORPO: Estatísticas + Histórico + Playstyles
             ════════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>    <!-- Estatísticas -->
                <ColumnDefinition Width="260"/>  <!-- Histórico e Playstyles -->
            </Grid.ColumnDefinitions>

            <!-- Overlay de carregamento -->
            <Grid Grid.ColumnSpan="2" Panel.ZIndex="10"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}">
                <Border Background="#CC0A0A18">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏳ Carregando detalhes..."
                                   Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Coluna de Estatísticas ─────────────────────────────────────────── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>
                    <!-- Stats principais como barras grandes -->
                    <TextBlock Text="ATRIBUTOS PRINCIPAIS" Style="{StaticResource SectionLabel}"/>
                    <ItemsControl x:Name="MainStatsControl"
                                  ItemTemplate="{StaticResource MainStatTemplate}">
                        <!-- Populado no code-behind com os 6 atributos principais -->
                    </ItemsControl>

                    <!-- Sub-estatísticas por grupo -->
                    <TextBlock Text="SUB-ESTATÍSTICAS" Style="{StaticResource SectionLabel}"
                               Margin="0,14,0,6"/>
                    <ItemsControl ItemsSource="{Binding StatGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StatGroup}">
                                <Border Margin="0,0,0,12">
                                    <StackPanel>
                                        <!-- Título do grupo (ex: "VELOCIDADE") -->
                                        <TextBlock Text="{Binding Name}" FontSize="10"
                                                   FontWeight="Bold" Foreground="#5566BB"
                                                   Margin="0,0,0,4"/>
                                        <!-- Sub-stats do grupo -->
                                        <ItemsControl ItemsSource="{Binding Stats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:StatItem}">
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                   Style="{StaticResource AttrLabel}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                                   FontSize="12" FontWeight="Bold"
                                                                   Foreground="White"
                                                                   TextAlignment="Right" Margin="0,0,6,0"/>
                                                        <!-- Barra de progresso -->
                                                        <Border Grid.Column="2" Height="8" CornerRadius="4"
                                                                Background="#222244" VerticalAlignment="Center">
                                                            <Border CornerRadius="4" HorizontalAlignment="Left"
                                                                    Width="{Binding BarWidth}">
                                                                <Border.Background>
                                                                    <SolidColorBrush Color="{Binding BarColor}"/>
                                                                </Border.Background>
                                                            </Border>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ── Coluna Direita: Histórico + Playstyles ────────────────────────── -->
            <Border Grid.Column="1" Background="#12122A" BorderBrush="#2A2A4A"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>

                        <!-- Histórico de Preços -->
                        <TextBlock Text="HISTÓRICO DE PREÇOS" Style="{StaticResource SectionLabel}"/>

                        <TextBlock Text="Carregando histórico..."
                                   FontSize="11" Foreground="#666688"
                                   Visibility="{Binding IsLoadingHistory, Converter={StaticResource BoolToVisible}}"/>

                        <TextBlock Text="Histórico não disponível."
                                   FontSize="11" Foreground="#555577">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasPriceHistory}" Value="False"/>
                                                <Condition Binding="{Binding IsLoadingHistory}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Gráfico de preços (desenhado em code-behind) -->
                        <Canvas x:Name="PriceChart" Height="110" Background="#0D0D20"
                                Margin="0,0,0,6"
                                Visibility="{Binding HasPriceHistory, Converter={StaticResource BoolToVisible}}">
                            <!-- Linhas de grade horizontais -->
                            <Line X1="0" Y1="30" X2="240" Y2="30"
                                  Stroke="#222244" StrokeThickness="1" StrokeDashArray="4 4"/>
                            <Line X1="0" Y1="60" X2="240" Y2="60"
                                  Stroke="#222244" StrokeThickness="1" StrokeDashArray="4 4"/>
                            <Line X1="0" Y1="90" X2="240" Y2="90"
                                  Stroke="#222244" StrokeThickness="1" StrokeDashArray="4 4"/>
                        </Canvas>

                        <!-- Tabela dos últimos dias -->
                        <Border Background="#0D0D20" CornerRadius="4" Padding="8"
                                Visibility="{Binding HasPriceHistory, Converter={StaticResource BoolToVisible}}">
                            <ItemsControl ItemsSource="{Binding PriceHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DateFormatted}"
                                                       FontSize="10" Foreground="#777799"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PricePSFormatted}"
                                                       FontSize="10" FontWeight="Bold" Foreground="#FFD700"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Playstyles normais -->
                        <TextBlock Text="PLAYSTYLES" Style="{StaticResource SectionLabel}"
                                   Margin="0,14,0,4"/>
                        <TextBlock Text="Nenhum playstyle." FontSize="10" Foreground="#555577"
                                   Visibility="{Binding Card.Playstyles.Count,
                                       Converter={StaticResource CountToVisible}, ConverterParameter=Invert}"/>
                        <ItemsControl ItemsSource="{Binding Card.Playstyles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#252550" CornerRadius="4"
                                            Padding="6,3" Margin="0,0,4,4">
                                        <TextBlock Text="{Binding}" FontSize="10" Foreground="#AAAAEE"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Playstyle+ -->
                        <TextBlock Text="PLAYSTYLE+" Style="{StaticResource SectionLabel}"
                                   Margin="0,10,0,4"
                                   Visibility="{Binding Card.PlaystylePlus.Count,
                                       Converter={StaticResource CountToVisible}}"/>
                        <ItemsControl ItemsSource="{Binding Card.PlaystylePlus}"
                                      Visibility="{Binding Card.PlaystylePlus.Count,
                                          Converter={StaticResource CountToVisible}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#3D2A6B" CornerRadius="4"
                                            Padding="6,3" Margin="0,0,4,4">
                                        <TextBlock Text="{Binding}" FontSize="10" Foreground="#DDA0FF"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Banner de erro -->
                        <Border Background="#5C0000" CornerRadius="6" Padding="10,8"
                                Margin="0,12,0,0"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisible}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="11" Foreground="#FFAAAA" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
