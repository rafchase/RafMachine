<UserControl x:Class="FutbinSearch.Views.Controls.PlayerCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FutbinSearch.Converters"
             Width="160" Height="240"
             Cursor="Hand">

    <UserControl.Resources>
        <conv:HexColorToBrushConverter x:Key="HexToBrush"/>
        <conv:RatingToColorConverter   x:Key="RatingColor"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisible"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisible"/>
    </UserControl.Resources>

    <!-- Cartão com efeito de profundidade (DropShadow) -->
    <Border CornerRadius="8" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="8" ShadowDepth="3"/>
        </Border.Effect>

        <!-- Fundo do cartão com cor dinâmica baseada no tipo -->
        <Grid Background="{Binding CardColor, Converter={StaticResource HexToBrush}}">

            <!-- Gradiente sobre o fundo para efeito visual de brilho -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#CC000000" Offset="0"/>
                    <GradientStop Color="#88000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Overlay colorido com a cor da carta (aplica sobre o gradiente) -->
            <Border>
                <Border.Background>
                    <SolidColorBrush Color="{Binding CardColor}" Opacity="0.6"/>
                </Border.Background>
            </Border>

            <!-- Layout principal do cartão -->
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Rating e Posição -->
                    <RowDefinition Height="*"/>     <!-- Imagem do jogador -->
                    <RowDefinition Height="Auto"/>  <!-- Nome -->
                    <RowDefinition Height="Auto"/>  <!-- Stats principais -->
                    <RowDefinition Height="Auto"/>  <!-- Preço -->
                </Grid.RowDefinitions>

                <!-- ── Linha 1: Rating e Posição (topo esquerdo) ── -->
                <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Left">
                    <!-- Rating grande -->
                    <TextBlock Text="{Binding Rating}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{Binding Rating, Converter={StaticResource RatingColor}}"
                               HorizontalAlignment="Center"/>
                    <!-- Posição -->
                    <TextBlock Text="{Binding Position}"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="White" Opacity="0.9"
                               HorizontalAlignment="Center"/>
                    <!-- Tipo de carta (badge pequeno) -->
                    <Border Background="#33FFFFFF" CornerRadius="3" Padding="2,0" Margin="0,2,0,0">
                        <TextBlock Text="{Binding CardType}"
                                   FontSize="7" Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- ── Linha 2: Imagem da carta ou foto do jogador ── -->
                <Grid Grid.Row="1" Margin="0,4">
                    <!-- Placeholder enquanto carrega -->
                    <Border Background="#22FFFFFF" CornerRadius="4" Height="90" Width="90"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⚽" FontSize="32" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Opacity="0.4"/>
                    </Border>

                    <!-- Imagem do jogador (carregada de forma lazy no code-behind) -->
                    <Image x:Name="PlayerImage"
                           Height="100" Width="100"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>

                <!-- ── Linha 3: Nome do jogador ── -->
                <TextBlock Grid.Row="2"
                           Text="{Binding DisplayName}"
                           FontSize="11" FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"
                           Margin="0,2"/>

                <!-- ── Linha 4: Stats principais (PAC, SHO, PAS, DRI, DEF, PHY) ── -->
                <UniformGrid Grid.Row="3" Columns="3" Rows="2" Margin="0,4">
                    <!-- PAC -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="1">
                        <TextBlock Text="{Binding Stats.Pace}"
                                   FontSize="9" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" PAC" FontSize="8" Foreground="#CCFFFFFF"/>
                    </StackPanel>
                    <!-- SHO -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="1">
                        <TextBlock Text="{Binding Stats.Shooting}"
                                   FontSize="9" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" SHO" FontSize="8" Foreground="#CCFFFFFF"/>
                    </StackPanel>
                    <!-- PAS -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="1">
                        <TextBlock Text="{Binding Stats.Passing}"
                                   FontSize="9" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" PAS" FontSize="8" Foreground="#CCFFFFFF"/>
                    </StackPanel>
                    <!-- DRI -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="1">
                        <TextBlock Text="{Binding Stats.Dribbling}"
                                   FontSize="9" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" DRI" FontSize="8" Foreground="#CCFFFFFF"/>
                    </StackPanel>
                    <!-- DEF -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="1">
                        <TextBlock Text="{Binding Stats.Defending}"
                                   FontSize="9" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" DEF" FontSize="8" Foreground="#CCFFFFFF"/>
                    </StackPanel>
                    <!-- PHY -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="1">
                        <TextBlock Text="{Binding Stats.Physical}"
                                   FontSize="9" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" PHY" FontSize="8" Foreground="#CCFFFFFF"/>
                    </StackPanel>
                </UniformGrid>

                <!-- ── Linha 5: Preço ── -->
                <Border Grid.Row="4" Background="#44000000" CornerRadius="4" Padding="4,2" Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="💰 " FontSize="9"/>
                        <TextBlock Text="{Binding PriceFormatted}"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#FFD700"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Overlay de hover (fica invisível e escurece ao passar o mouse) -->
            <Border x:Name="HoverOverlay" Background="#00FFFFFF" CornerRadius="8" IsHitTestVisible="False"/>
        </Grid>

        <!-- Animação de hover -->
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="HoverOverlay"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)"
                                    To="0.2" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="HoverOverlay"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)"
                                    To="0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>
</UserControl>
