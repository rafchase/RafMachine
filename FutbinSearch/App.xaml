<Application x:Class="FutbinSearch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">

    <Application.Resources>
        <!-- Estilos globais aplicados a toda a aplicação -->

        <!-- ScrollBar fina e discreta com tema escuro -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="#1A1A2E"/>
        </Style>

        <!-- ScrollViewer sem bordas visíveis -->
        <Style TargetType="ScrollViewer">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Separador com cor de tema escuro -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#2A2A4A"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>

        <!-- TextBox: sem outline azul do sistema ao focar -->
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- ComboBox: sem outline azul ao focar -->
        <Style TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

    </Application.Resources>
</Application>
